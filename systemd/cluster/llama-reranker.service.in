# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=KevinBeLLM reranking model on Machine B
Documentation=https://github.com/ggml-org/llama.cpp/tree/b10451/tools/server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# The cross-encoder scores query/passage pairs, so one micro-batch must hold
# both halves. Same non-causal micro-batch requirement as the embedding unit.
Environment=KEVINBELLM_RERANK_CTX_SIZE=4096
Environment=KEVINBELLM_RERANK_BATCH_SIZE=4096
Environment=KEVINBELLM_RERANK_UBATCH_SIZE=4096
Environment=KEVINBELLM_RERANK_THREADS=4
Environment=KEVINBELLM_RERANK_PARALLEL=1
Environment=KEVINBELLM_RERANK_GPU_LAYERS=all
Environment=RERANKER_MODEL_ALIAS=kevinbellm-rerank
EnvironmentFile=@RETRIEVAL_ENV@
UnsetEnvironment=XDG_CONFIG_HOME HOME LLAMA_ARG_RPC LLAMA_ARG_RPC_SERVERS LLAMA_ARG_HF_REPO LLAMA_ARG_HF_FILE LLAMA_ARG_MODEL_URL LLAMA_ARG_DOCKER_REPO LLAMA_ARG_MODELS_PRESET LLAMA_ARG_MODELS_DIR
ExecStartPre=/usr/bin/test -r "${RERANKER_MODEL_PATH}"
ExecStart=/usr/bin/env -i CUDA_VISIBLE_DEVICES=0 "@LLAMA_SERVER_BIN@" --model ${RERANKER_MODEL_PATH} --alias ${RERANKER_MODEL_ALIAS} --host 127.0.0.1 --port 8082 --reranking --pooling rank --offline --no-agent --ctx-size ${KEVINBELLM_RERANK_CTX_SIZE} --batch-size ${KEVINBELLM_RERANK_BATCH_SIZE} --ubatch-size ${KEVINBELLM_RERANK_UBATCH_SIZE} --threads ${KEVINBELLM_RERANK_THREADS} --parallel ${KEVINBELLM_RERANK_PARALLEL} --n-gpu-layers ${KEVINBELLM_RERANK_GPU_LAYERS} --split-mode none --device CUDA0 --load-mode mmap --no-mmproj --no-webui --no-slots
Restart=on-failure
RestartSec=15
TimeoutStartSec=0
TimeoutStopSec=120
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
ReadWritePaths=-%h/.cache/llama.cpp
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.config -/etc/llama.cpp

[Install]
WantedBy=default.target
