# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=KevinBeLLM encrypted loopback tunnel to Machine B RPC
Documentation=man:ssh(1)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=@COORDINATOR_ENV@
ExecCondition=/usr/bin/test "${ACKNOWLEDGE_LLAMA_RPC_RCE}" = YES_I_ACCEPT_UNAUTHENTICATED_RCE_RISK
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=@WORKER_KNOWN_HOSTS@" -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -i "@TUNNEL_KEY@" -p ${WORKER_SSH_PORT} -L 127.0.0.1:50053:127.0.0.1:50052 ${WORKER_SSH_TARGET}
# A listening SSH forward does not prove that the worker behind it is ready.
# Complete an RPC device-discovery handshake before llama-server may start.
ExecStartPost=/usr/bin/timeout 120 /bin/bash -c 'until /usr/bin/timeout 10 "@LLAMA_BENCH_BIN@" --rpc 127.0.0.1:50053 --list-devices 2>&1 | /usr/bin/grep -Eq "^[[:space:]]*RPC[[:digit:]]+:"; do sleep 2; done'
Restart=always
RestartSec=5
TimeoutStartSec=150
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectHostname=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# User services already run without capabilities, and NoNewPrivileges prevents
# gaining them. Ubuntu's user manager rejects CapabilityBoundingSet= here with
# status 218/CAPABILITIES, so it must not be set in this unprivileged unit.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=default.target
