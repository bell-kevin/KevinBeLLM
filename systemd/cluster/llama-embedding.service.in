# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=KevinBeLLM embedding model on Machine B
Documentation=https://github.com/ggml-org/llama.cpp/tree/b10451/tools/server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# bge-m3 is a non-causal encoder: llama.cpp must be able to hold a whole
# sequence in one micro-batch, so ubatch must be at least the context size.
# Indexed chunks are bounded near 1,500 characters, well inside 4,096 tokens.
Environment=KEVINBELLM_EMBED_CTX_SIZE=4096
Environment=KEVINBELLM_EMBED_BATCH_SIZE=4096
Environment=KEVINBELLM_EMBED_UBATCH_SIZE=4096
Environment=KEVINBELLM_EMBED_THREADS=4
Environment=KEVINBELLM_EMBED_PARALLEL=1
Environment=KEVINBELLM_EMBED_GPU_LAYERS=all
Environment=EMBEDDING_MODEL_ALIAS=kevinbellm-embed
EnvironmentFile=@RETRIEVAL_ENV@
UnsetEnvironment=XDG_CONFIG_HOME HOME LLAMA_ARG_RPC LLAMA_ARG_RPC_SERVERS LLAMA_ARG_HF_REPO LLAMA_ARG_HF_FILE LLAMA_ARG_MODEL_URL LLAMA_ARG_DOCKER_REPO LLAMA_ARG_MODELS_PRESET LLAMA_ARG_MODELS_DIR
ExecStartPre=/usr/bin/test -r "${EMBEDDING_MODEL_PATH}"
# Loopback endpoint, single-GPU selection, and the absence of --rpc are fixed
# here and cannot be changed through the private env file.
ExecStart=/usr/bin/env -i CUDA_VISIBLE_DEVICES=0 "@LLAMA_SERVER_BIN@" --model ${EMBEDDING_MODEL_PATH} --alias ${EMBEDDING_MODEL_ALIAS} --host 127.0.0.1 --port 8081 --embedding --pooling cls --offline --no-agent --ctx-size ${KEVINBELLM_EMBED_CTX_SIZE} --batch-size ${KEVINBELLM_EMBED_BATCH_SIZE} --ubatch-size ${KEVINBELLM_EMBED_UBATCH_SIZE} --threads ${KEVINBELLM_EMBED_THREADS} --parallel ${KEVINBELLM_EMBED_PARALLEL} --n-gpu-layers ${KEVINBELLM_EMBED_GPU_LAYERS} --split-mode none --device CUDA0 --load-mode mmap --no-mmproj --no-webui --no-slots
Restart=on-failure
RestartSec=15
TimeoutStartSec=0
TimeoutStopSec=120
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# Ubuntu's user manager rejects capability-changing directives such as
# CapabilityBoundingSet=, ProtectClock=, ProtectKernelModules=, and
# ProtectKernelLogs= with status 218/CAPABILITIES.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
ReadWritePaths=-%h/.cache/llama.cpp
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.config -/etc/llama.cpp

[Install]
WantedBy=default.target
