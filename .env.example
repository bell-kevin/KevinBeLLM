# Generated locally by ./scripts/setup.sh. Never commit the real .env file.
# setup.sh replaces this password in the private .env file. KevinBeLLM creates
# the account only when its database is empty, then stores an Argon2 hash.
ADMIN_NAME=KevinBeLLM Admin
ADMIN_EMAIL=admin@kevinbellm.local
ADMIN_PASSWORD=replace-with-random-admin-password

# Persistent account database volume.
KEVINBELLM_DATA_VOLUME=kevinbellm-data

# Use the public HTTPS URL only after configuring a named Cloudflare Tunnel.
PUBLIC_URL=http://localhost:3000

APP_PORT=3000
LIVE_TOOLS_HOST_PORT=8090
SEARXNG_HOST_PORT=8888

# The everyday build uses a standalone llama-server on Machine A. The app
# reaches llama-server over this loopback address.
INFERENCE_BASE_URL=http://127.0.0.1:8080

# llama-server exposes the deployed model through its stable 27B alias.
DEFAULT_MODEL=kevinbellm-27b
PREFERRED_MODELS=kevinbellm-27b
# How much research one answer may do. Measured on the deployed model: it issues
# two tool calls per round and wants 6-11 calls over 4-6 rounds for a research
# question, stopping on its own. Lower these to cap latency at the cost of
# cutting the model off mid-investigation.
MAX_TOOL_CALLS=12
MAX_TOOL_ROUNDS=8

# Bound both expensive model work and the small waiting queue.
CHAT_CONCURRENCY=1
CHAT_PENDING=2
CHAT_QUEUE_TIMEOUT_SECONDS=30
CHAT_DEADLINE_SECONDS=1200
FETCH_DEADLINE_SECONDS=30
DATABASE_CONCURRENCY=8
# Change this to the public source for this modified deployment before remote use.
SOURCE_URL=https://github.com/bell-kevin/KevinBeLLM

# Remote access uses infra/cloudflare/.env and a mode-0600 token file. Tunnel
# credentials never belong here or in GitHub Pages JavaScript.
