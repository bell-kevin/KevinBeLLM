# Generated locally by ./scripts/setup.sh. Never commit the real .env file.
# setup.sh replaces this password in the private .env file. KevinBeLLM creates
# the account only when its database is empty, then stores an Argon2 hash.
ADMIN_NAME=KevinBeLLM Admin
ADMIN_EMAIL=admin@kevinbellm.local
ADMIN_PASSWORD=replace-with-random-admin-password

# Use the public HTTPS URL only after configuring a named Cloudflare Tunnel.
PUBLIC_URL=http://localhost:3000

APP_PORT=3000
LIVE_TOOLS_HOST_PORT=8090
SEARXNG_HOST_PORT=8888

DEFAULT_MODEL=qwen3.6:35b-a3b-q4_K_M
PREFERRED_MODELS=qwen3.6:35b-a3b-q4_K_M,qwen3.5:9b-q4_K_M
OLLAMA_CONTEXT_LENGTH=16384
# Bound both expensive model work and the small waiting queue.
CHAT_PENDING=2
CHAT_QUEUE_TIMEOUT_SECONDS=30
CHAT_DEADLINE_SECONDS=1200
FETCH_DEADLINE_SECONDS=30
DATABASE_CONCURRENCY=8
SOURCE_URL=https://github.com/bell-kevin/ASUS-KevinBeLLM

# Remote access uses infra/cloudflare/.env and a mode-0600 token file. Tunnel
# credentials never belong here or in GitHub Pages JavaScript.
