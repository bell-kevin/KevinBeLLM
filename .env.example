# Generated locally by ./scripts/setup.sh. Never commit the real .env file.
# setup.sh replaces this password in the private .env file. KevinBeLLM creates
# the account only when its database is empty, then stores an Argon2 hash.
ADMIN_NAME=KevinBeLLM Admin
ADMIN_EMAIL=admin@kevinbellm.local
ADMIN_PASSWORD=replace-with-random-admin-password

# Persistent account database volume.
KEVINBELLM_DATA_VOLUME=kevinbellm-data

# Use the public HTTPS URL only after configuring a named Cloudflare Tunnel.
PUBLIC_URL=http://localhost:3000

# Zoo Code uses this OpenAI-compatible base URL. Keep the loopback default for
# SSH/LAN use. For remote use, set the HTTPS URL whose /v1/* route is protected
# by a narrowly scoped Cloudflare Access Service Auth policy (see the guide).
ZOO_API_BASE_URL=http://127.0.0.1:3000/v1
# Personal Zoo Code tokens are created only after web login + password
# confirmation, shown once, stored hashed, and expire automatically.
ZOO_TOKEN_TTL_DAYS=30
ZOO_MAX_OUTPUT_TOKENS=8192
ZOO_CONTEXT_WINDOW=32768
# Zoo requests default to Qwen3.8's deepest xhigh reasoning. Set false only to
# forbid reasoning requests; clients must then send reasoning_effort=none.
ZOO_ENABLE_THINKING=true

APP_PORT=3000
LIVE_TOOLS_HOST_PORT=8090
SEARXNG_HOST_PORT=8888

# The everyday build uses a standalone llama-server on Machine A. The app
# reaches llama-server over this loopback address.
INFERENCE_BASE_URL=http://127.0.0.1:8080

# llama-server exposes the deployed model through its stable 27B alias.
DEFAULT_MODEL=kevinbellm-27b
PREFERRED_MODELS=kevinbellm-27b
# How much research one answer may do. Measured on the deployed model: it issues
# two tool calls per round and wants 6-11 calls over 4-6 rounds for a research
# question, stopping on its own. These ceilings sit above that range so a harder
# question is not truncated; a question that finishes sooner pays nothing for the
# headroom. Lower them to cap worst-case latency.
MAX_TOOL_CALLS=20
MAX_TOOL_ROUNDS=12

# Extended thinking is the largest quality lever on this model, so it is the
# default and the composer toggle turns it off. It costs hundreds to thousands of
# tokens before any visible text, so set false to restore answer-first latency.
DEFAULT_REASONING=true
# Output ceilings, not targets: the model stops at its own stop token, so these
# only bite on answers long enough to have been truncated before. Both share the
# 32,768-token context with the prompt, so raising them spends prompt room.
ANSWER_MAX_TOKENS=4096
REASONING_MAX_TOKENS=12288

# Bound both expensive model work and the small waiting queue.
CHAT_CONCURRENCY=1
CHAT_PENDING=2
CHAT_QUEUE_TIMEOUT_SECONDS=30
CHAT_DEADLINE_SECONDS=1200
FETCH_DEADLINE_SECONDS=30
DATABASE_CONCURRENCY=8
# Change this to the public source for this modified deployment before remote use.
SOURCE_URL=https://github.com/bell-kevin/KevinBeLLM

# Remote access uses infra/cloudflare/.env and a mode-0600 token file. Tunnel
# credentials never belong here or in GitHub Pages JavaScript.
