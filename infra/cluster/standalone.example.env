# Private systemd EnvironmentFile for Machine A's everyday standalone service.
# Installed as ~/.config/kevinbellm-cluster/standalone.env (mode 0600).
# This profile neither starts nor connects to llama.cpp RPC.

# Downloaded and checksum-verified by scripts/cluster/download-model.sh.
MODEL_PRESET=9b-q6_k
MODEL_PATH=/home/CHANGE_ME/models/Qwen_Qwen3.5-9B-Q6_K.gguf
LLAMA_MODEL_ALIAS=kevinbellm-9b

# Repeated local measurements on the RTX 3060 produced about 53-69 generation
# tokens/second, median 62, with 3,322 MiB of VRAM free. This model's KV cache
# is unusually cheap: 32,768-token context costs little over 4,096, so the small
# context was giving up capability for nothing. Change one setting at a time and
# benchmark before making a different configuration persistent. Benchmark across
# several kinds of output, at the temperature the application actually sends,
# and at a realistic prompt length; a single short prompt at temperature 0 will
# mis-rank these settings.
KEVINBELLM_LLAMA_CTX_SIZE=32768
KEVINBELLM_LLAMA_BATCH_SIZE=2048
KEVINBELLM_LLAMA_UBATCH_SIZE=512
KEVINBELLM_LLAMA_THREADS=8
KEVINBELLM_LLAMA_PARALLEL=1
KEVINBELLM_LLAMA_GPU_LAYERS=all
# f16 rather than q8_0: at short prompts the two are identical, but f16 removes
# a dequantization step that costs real time once the KV cache is large. Worth
# about 8% at a 24,000-token prompt, for about 500 MiB of VRAM.
KEVINBELLM_LLAMA_CACHE_TYPE_K=f16
KEVINBELLM_LLAMA_CACHE_TYPE_V=f16
KEVINBELLM_LLAMA_FLASH_ATTN=on
# Measured draft-depth sweep (1,2,3,4,6,8) over ten output types: 2 is the peak,
# 3 is close behind, and both beat 4. Depth 2 also raises the slowest workloads
# far more than it costs the fastest, which matters more than peak throughput
# for an interactive assistant.
KEVINBELLM_LLAMA_SPEC_DRAFT_N_MAX=2
