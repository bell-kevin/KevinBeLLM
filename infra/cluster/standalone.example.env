# Private systemd EnvironmentFile for Machine A's everyday standalone service.
# Installed as ~/.config/kevinbellm-cluster/standalone.env (mode 0600).
# This profile neither starts nor connects to llama.cpp RPC.

# Downloaded and checksum-verified by scripts/cluster/download-model.sh.
MODEL_PRESET=9b-q6_k
MODEL_PATH=/home/CHANGE_ME/models/Qwen_Qwen3.5-9B-Q6_K.gguf
LLAMA_MODEL_ALIAS=kevinbellm-9b

# Repeated local measurements on the RTX 3060 produced about 54 generation
# tokens/second with 4,388 MiB of VRAM free. Change one setting at a
# time and benchmark before making a different configuration persistent.
KEVINBELLM_LLAMA_CTX_SIZE=4096
KEVINBELLM_LLAMA_BATCH_SIZE=2048
KEVINBELLM_LLAMA_UBATCH_SIZE=512
KEVINBELLM_LLAMA_THREADS=8
KEVINBELLM_LLAMA_PARALLEL=1
KEVINBELLM_LLAMA_GPU_LAYERS=all
KEVINBELLM_LLAMA_CACHE_TYPE_K=q8_0
KEVINBELLM_LLAMA_CACHE_TYPE_V=q8_0
KEVINBELLM_LLAMA_FLASH_ATTN=on
KEVINBELLM_LLAMA_SPEC_DRAFT_N_MAX=3
