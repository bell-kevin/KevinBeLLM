# Private systemd EnvironmentFile for Machine A's inference service.
# Installed as ~/.config/kevinbellm-cluster/standalone.env (mode 0600).
# This deployment neither starts nor connects to llama.cpp RPC.

# Downloaded and checksum-verified by scripts/cluster/download-model.sh.
MODEL_PRESET=27b-iq4_xs
MODEL_PATH=/home/CHANGE_ME/models/Qwen3.8-27B-UD-IQ4_XS.gguf
LLAMA_MODEL_ALIAS=kevinbellm-27b

# Measured on the RTX 3060 + RTX 3070 pair, layer-split, at the temperature the
# application actually sends. The reproducible 128-token corpus measures 29.00
# generation tokens/second with a tool schema and 34.53 unconstrained; a cold
# 14,879-token prompt prefills at about 466 tokens/second. Change one setting at
# a time and benchmark across several output types before making it persistent.
KEVINBELLM_LLAMA_CTX_SIZE=32768
KEVINBELLM_LLAMA_BATCH_SIZE=2048
# 512, not larger. Each ubatch boundary ships ubatch x 5120 x 2 bytes across the
# PCIe 2.0 x1 riser, so 1024 makes prefill WORSE (470 -> 458) and 2048 exhausts
# VRAM and leaves the unit crash-looping.
KEVINBELLM_LLAMA_UBATCH_SIZE=512
KEVINBELLM_LLAMA_THREADS=8
KEVINBELLM_LLAMA_THREADS_BATCH=8
KEVINBELLM_LLAMA_POLL=50
KEVINBELLM_LLAMA_POLL_BATCH=50
KEVINBELLM_LLAMA_PARALLEL=1
KEVINBELLM_LLAMA_GPU_LAYERS=all
# q8_0, not f16. This model costs 0.25 MiB/token of KV, so 32k of f16 KV needs
# 8 GiB on top of 13.26 GiB of weights and does not fit in the 19.3 GiB pool.
KEVINBELLM_LLAMA_CACHE_TYPE_K=q8_0
KEVINBELLM_LLAMA_CACHE_TYPE_V=q8_0
KEVINBELLM_LLAMA_FLASH_ATTN=on
# Swept none/draft-mtp/ngram-cache/ngram-simple: MTP is the only draft source
# that beats no speculation at all (23.0 vs 17.2 tokens/second). Both ngram
# modes are worse than none. MTP costs prefill (615 -> 467) to buy that decode.
KEVINBELLM_LLAMA_SPEC_TYPE=draft-mtp
# Depth swept over 1,2,3,4,6: 2 peaks at 24.3 and 6 collapses to 17.6.
KEVINBELLM_LLAMA_SPEC_DRAFT_N_MAX=2
# A 0.8 draft probability threshold reduced both Fast and tool-schema decode at
# n-max 2 and 4. Keep the measured zero threshold.
KEVINBELLM_LLAMA_SPEC_DRAFT_P_MIN=0.0
# Eight recurrent-state checkpoints matched 32 on an 8.3k divergent-prefix
# probe, while zero checkpoints forced a full re-prefill. A 4 GiB state cache
# preserved the same three-prompt restore hits as 8 GiB with more RAM headroom.
KEVINBELLM_LLAMA_CTX_CHECKPOINTS=8
KEVINBELLM_LLAMA_CACHE_RAM=4096
# 64,36 rather than 60,40: at a full 32k prefill the 8 GiB card peaked at
# 7,643 MiB with 60,40, leaving ~200 MiB. Shifting layers to the 12 GiB card
# costs about 1% of decode and roughly quadruples that margin.
KEVINBELLM_LLAMA_TENSOR_SPLIT=64,36
