# Private systemd EnvironmentFile for Machine B's optional document retrieval.
# Installed as ~/.config/kevinbellm-cluster/retrieval.env (mode 0600).
#
# This profile starts no llama.cpp RPC process, client address, or listener, and
# needs no risk acknowledgment. All three services bind Machine B loopback only.
# Machine A reaches port 8091 through an SSH forward, never over the LAN.

# Downloaded and checksum-verified by scripts/cluster/download-model.sh.
#   ./scripts/cluster/download-model.sh --preset embed-m3
#   ./scripts/cluster/download-model.sh --preset rerank-m3
EMBEDDING_MODEL_PATH=/home/CHANGE_ME/models/bge-m3-Q8_0.gguf
EMBEDDING_MODEL_ALIAS=kevinbellm-embed
RERANKER_MODEL_PATH=/home/CHANGE_ME/models/bge-reranker-v2-m3-Q8_0.gguf
RERANKER_MODEL_ALIAS=kevinbellm-rerank

# Where the offline indexer writes, and the API reads at startup. Private text
# lives here, so keep it off any shared or synchronised directory.
RETRIEVAL_INDEX_DIR=/home/CHANGE_ME/.local/share/kevinbellm-retrieval/index

# The documents to index. The indexer reads text-like files only and never
# follows a symlink out of this directory.
RETRIEVAL_SOURCE_DIR=/home/CHANGE_ME/documents

# Dense-search depth handed to the cross-encoder, and the ceiling on returned
# passages. Larger candidate counts cost Machine B GPU time, never Machine A.
RETRIEVAL_CANDIDATES=40
RETRIEVAL_MAX_RESULTS=10
RETRIEVAL_EXCERPT_CHARS=1200

# Refuse to load an index larger than this. 50,000 chunks of 1,024 float32
# dimensions is about 205 MiB of resident vectors.
RETRIEVAL_MAX_CHUNKS=50000
RETRIEVAL_BACKEND_TIMEOUT_SECONDS=20

# Optional relevance floor on the reranker's logit, disabled while empty.
# Measure real queries against your own collection before setting one: a guessed
# threshold silently hides correct answers. Around 0 is the usual decision
# boundary for bge-reranker-v2-m3.
# RETRIEVAL_MIN_SCORE=0

# Conservative RTX 3070 defaults measured against nothing yet; both models
# together use roughly 1.4 GiB of its 8 GiB. Micro-batch size must stay at or
# above the context size because both models are non-causal encoders.
KEVINBELLM_EMBED_CTX_SIZE=4096
KEVINBELLM_EMBED_BATCH_SIZE=4096
KEVINBELLM_EMBED_UBATCH_SIZE=4096
KEVINBELLM_EMBED_THREADS=4
KEVINBELLM_RERANK_CTX_SIZE=4096
KEVINBELLM_RERANK_BATCH_SIZE=4096
KEVINBELLM_RERANK_UBATCH_SIZE=4096
KEVINBELLM_RERANK_THREADS=4
