# Private systemd EnvironmentFile for Machine A's outbound retrieval tunnel.
# Installed as ~/.config/kevinbellm-cluster/retrieval-client.env (mode 0600).
#
# This unit only forwards Machine A's loopback TCP 8091 to Machine B's loopback
# TCP 8091. It carries ordinary HTTP to a read-only search API, not llama.cpp
# RPC, and it is never a dependency of inference, the application, or the
# Cloudflare connector. If Machine B is powered off, this unit simply retries
# and the assistant answers without local documents.

# Dedicated no-shell account created on Machine B by
# scripts/cluster/install-retrieval-tunnel-key.sh. Prefer its reserved IP.
RETRIEVAL_SSH_TARGET=kevinbellm-retrieval@CHANGE_ME_MACHINE_B_IP
RETRIEVAL_SSH_PORT=22
