# Private systemd EnvironmentFile for Machine A.
# Installed as ~/.config/kevinbellm-cluster/coordinator.env (mode 0600).

# Required deliberate acknowledgment. Read infra/cluster/README.md first.
ACKNOWLEDGE_LLAMA_RPC_RCE=

# Dedicated no-shell account created on Machine B. Prefer its router-reserved IP.
WORKER_SSH_TARGET=llama-rpc-tunnel@CHANGE_ME_MACHINE_B_IP
WORKER_SSH_PORT=22

# Downloaded and checksum-verified by scripts/cluster/download-model.sh.
MODEL_PATH=/home/CHANGE_ME/models/Qwen_Qwen3.5-27B-Q4_K_M.gguf
LLAMA_MODEL_ALIAS=kevinbellm-27b

# Conservative 20 GB defaults; these override unit defaults when changed.
LLAMA_ARG_CTX_SIZE=8192
LLAMA_ARG_N_PARALLEL=1
LLAMA_ARG_CACHE_RAM=0
LLAMA_ARG_SPLIT_MODE=layer
LLAMA_ARG_N_GPU_LAYERS=auto
LLAMA_ARG_FIT=on
LLAMA_ARG_JINJA=true
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0

# Optional tuning after the default is measured. Device order is normally the
# coordinator's 12 GB CUDA0 followed by the worker RPC device. Let --fit choose
# first; an incorrect tensor split can cause allocation failure.
# LLAMA_ARG_TENSOR_SPLIT=12,8
