# Private systemd EnvironmentFile for Machine B.
# Installed as ~/.config/kevinbellm-cluster/worker.env (mode 0600).

# Required deliberate acknowledgment. Read infra/cluster/README.md first.
ACKNOWLEDGE_LLAMA_RPC_RCE=

# Expose only the RTX 3070 to this service. The endpoint itself is hardcoded to
# 127.0.0.1:50052 in the unit and cannot be overridden here.
CUDA_VISIBLE_DEVICES=0
