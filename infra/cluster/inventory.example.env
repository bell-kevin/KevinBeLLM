# Copy to inventory.env on the laptop. Reserve the IPv4 address in the
# router by MAC address before using them. Never configure router port forwards.
MACHINE_A_HOST=CHANGE_ME_MACHINE_A_IP
MACHINE_A_SSH_USER=CHANGE_ME
MACHINE_A_SSH_PORT=22
# Detected on the current laptop; confirm this still matches the router.
LAN_CIDR=192.168.0.0/24
