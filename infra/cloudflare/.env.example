# Safe, non-secret defaults. Copy to .env and adapt to this host.
LOCAL_UID=1000
LOCAL_GID=1000
CLOUDFLARED_LOG_LEVEL=info
CLOUDFLARED_METRICS_PORT=20241

# Dashboard worksheet values; a remotely managed tunnel stores its route at
# Cloudflare, so Compose does not consume these two variables.
KEVINBELLM_PUBLIC_HOSTNAME=assistant.example.com
KEVINBELLM_ORIGIN=http://127.0.0.1:3000

# The tunnel token does NOT belong in this file. Store it, by itself, in:
#   infra/cloudflare/secrets/tunnel-token
